# SkillMount Homebrew formula template for the `@PACKAGE_ID@` package.
#
# Generated into Formula/@PACKAGE_ID@.rb by
# `.github/scripts/package_channels.py generate-homebrew`. Edit this template, never the
# generated formula: the tap copy is rewritten from here on every release.
#
# Provenance of the release archive this formula installs:
#   tag    @TAG@
#   commit @COMMIT@
class @FORMULA_CLASS@ < Formula
  desc "@DESCRIPTION@"
  homepage "@HOMEPAGE@"
  url "@ARCHIVE_URL@"
  sha256 "@ARCHIVE_SHA256@"
  license @LICENSE@

  depends_on arch: :arm64
  depends_on :macos

  def install
    bin.install "@COMMAND@"
    pkgshare.install "LICENSE-APACHE", "LICENSE-MIT", "VERSION"
    generate_completions_from_executable(bin/"@COMMAND@", "completions", base_name: "@COMMAND@")
  end

  test do
    assert_match "@VERSION@", shell_output("#{bin}/@COMMAND@ --version")
    assert_match "Usage:", shell_output("#{bin}/@COMMAND@ --help")

    # SkillMount resolves its product identity from argv[0] and rejects a renamed alias, so
    # this keg must carry exactly one executable and never the paired package's command.
    refute_path_exists bin/"@OTHER_COMMAND@"

    [
      [bash_completion/"@COMMAND@", "bash"],
      [zsh_completion/"_@COMMAND@", "zsh"],
      [fish_completion/"@COMMAND@.fish", "fish"],
    ].each do |completion, shell|
      assert_path_exists completion, "no #{shell} completion was generated"
      contents = completion.read
      assert_match "@COMMAND@", contents
      refute_match(/\b@OTHER_COMMAND@\b/, contents)
    end
  end
end
